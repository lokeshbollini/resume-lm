# ===========================================
# APPLICATION
# ===========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# SELF-HOSTED MODE
# ===========================================
# Collapses the Free/Pro split into a single unlimited tier: every signed-in
# user of this instance gets Pro model access and unlimited resumes, and the
# pricing/upgrade UI disappears.
#
# THIS DOES NOT MAKE AI FREE. It moves the bill to you: every request funded by
# this instance charges the provider key below. If you share the instance,
# set AI_RATE_LIMIT_CAPACITY and configure Redis, or point users at Ollama.
NEXT_PUBLIC_SELF_HOST_UNLIMITED=true

# ===========================================
# AI PROVIDERS
# ===========================================
# Required for ResumeLM's app-funded defaults (GPT-5.6 Luna and GPT-5.6 Terra)
OPENROUTER_API_KEY=
# Direct Anthropic key. In self-hosted mode this funds the "(Anthropic key)"
# models for every user of the instance, not just BYOK users.
ANTHROPIC_API_KEY=
# Retained for compatibility with custom/legacy deployments
OPENAI_API_KEY=

# --- Ollama: local models, zero cost per request ---
# Comma-separated list of model tags you have pulled (`ollama list`).
# Leave unset to hide Ollama from the model picker.
# NEXT_PUBLIC_OLLAMA_MODELS=llama3.1:8b,qwen2.5:14b
# Where the Ollama server is. Default below matches a standard local install.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Default model for this instance ---
# REQUIRED if you have no OPENROUTER_API_KEY. Upstream hardcodes every task
# default (text import, scoring, cover letters) to an OpenRouter model, so
# without this those actions fail with "No OpenRouter API key configured" no
# matter what the model picker shows. Set it to something you can actually
# serve, e.g. "ollama/llama3.1:8b" or "claude-sonnet-5".
# An explicit choice in the model picker still wins over this.
# NEXT_PUBLIC_SELF_HOST_DEFAULT_MODEL=ollama/llama3.1:8b

# --- Google sign-in ---
# On a self-hosted instance the "Continue with Google" button is hidden unless
# you set this to true, because it needs a Google provider enabled in the
# Supabase dashboard (backed by an OAuth client in Google Cloud). Without that
# it fails with "Unsupported provider: provider is not enabled".
# NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true

# --- Spend guardrails (only enforced when Redis is configured) ---
# Max AI requests per user per window, and the window length in seconds.
# Defaults: 80 requests per 5 hours.
# AI_RATE_LIMIT_CAPACITY=80
# AI_RATE_LIMIT_WINDOW_SECONDS=18000

# ===========================================
# SUPABASE (Pre-configured for Docker)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# ===========================================
# DOCKER OPTIONS
# ===========================================
# Admin user created on Docker startup:
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=Admin123

# Auto-grant Pro subscription (skip Stripe for local dev):
AUTO_PRO_SUBSCRIPTION=true

# Redis setup — powers per-user AI rate limiting only.
#
# These defaults assume the docker/ compose stack, which runs a Redis. If you
# are running `pnpm dev` directly with no Redis on :6379, set USE_LOCAL_REDIS
# to false; otherwise the app logs connection warnings on every AI request.
# With no Redis configured, rate limiting is skipped and the instance is
# unmetered — fine for personal use, worth fixing before you share a URL.
USE_LOCAL_REDIS=false
# REDIS_URL=redis://localhost:6379

# For cloud deployments, use Upstash instead:
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ===========================================
# STRIPE (Optional - for payment testing)
# ===========================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
CRON_SECRET=your_vercel_cron_secret
# Optional Slack/Discord-compatible webhook for deduplicated billing alerts.
BILLING_ALERT_WEBHOOK_URL=

# ===========================================
# POSTHOG (Optional - Product Analytics)
# ===========================================
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional server-side alias for PostHog LLM analytics. Falls back to NEXT_PUBLIC_POSTHOG_KEY.
# POSTHOG_PROJECT_API_KEY=phc_...
# Set to true to disable PostHog LLM analytics without disabling product analytics.
POSTHOG_LLM_ANALYTICS_DISABLED=false
